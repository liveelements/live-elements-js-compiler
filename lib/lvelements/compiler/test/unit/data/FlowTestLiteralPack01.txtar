export const bare = Flow.fn('bare', Flow.create('a', undefined, [Flow.call(pass, [{flow: Flow.create('v', undefined, [Flow.ret(Flow.ref('v'))])}], 'r'), Flow.ret(Flow.ref('r'))]), {
    get sourceFileName(){ return 'object-flow.lv' },
    get parameterNames(){ return ['a'] }
})
export const ret = Flow.fn('ret', Flow.create('a', undefined, [Flow.ret({flow: Flow.create('v', undefined, [Flow.ret(Flow.ref('v'))])})]), {
