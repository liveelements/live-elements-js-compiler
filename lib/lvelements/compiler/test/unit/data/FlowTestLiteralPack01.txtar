-- string-key.lv --
import {pass} from './flow-tools.mjs'

@fn call(a: any): any %> {
    pass({ 'a-b': 1 }) @r
    return r
}

@fn bare(a: any): any %> {
    pass { 'a-b': 1 } @r
    return r
}

@fn ret(a: any): any %> {
    return { 'a-b': 1 }
}
