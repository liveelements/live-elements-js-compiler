Flow literals that hold constants and flow literals. Each .lv compiles to the .lv.js next to it.
-- array-flow.lv --
import {pass} from './flow-tools.mjs'

@fn call(a: any): any %> {
    pass([1, (v: number) %> { return v }]) @r
    return r
}

@fn bare(a: any): any %> {
    pass [1, (v: number) %> { return v }] @r
    return r
}

@fn ret(a: any): any %> {
    return [1, (v: number) %> { return v }]
}
-- array-flow.lv.js --
import {pass} from './flow-tools.mjs'
import {Flow} from 'flow/flow.mjs'
export const call = Flow.fn('call', Flow.create('a', undefined, [Flow.call(pass, [[1, Flow.create('v', undefined, [Flow.ret(Flow.ref('v'))])]], 'r'), Flow.ret(Flow.ref('r'))]), {
    get sourceFileName(){ return 'array-flow.lv' },
    get parameterNames(){ return ['a'] }
})
export const bare = Flow.fn('bare', Flow.create('a', undefined, [Flow.call(pass, [[1, Flow.create('v', undefined, [Flow.ret(Flow.ref('v'))])]], 'r'), Flow.ret(Flow.ref('r'))]), {
    get sourceFileName(){ return 'array-flow.lv' },
    get parameterNames(){ return ['a'] }
})
export const ret = Flow.fn('ret', Flow.create('a', undefined, [Flow.ret([1, Flow.create('v', undefined, [Flow.ret(Flow.ref('v'))])])]), {
    get sourceFileName(){ return 'array-flow.lv' },
    get parameterNames(){ return ['a'] }
})
-- object-flow.lv --
import {pass} from './flow-tools.mjs'

@fn call(a: any): any %> {
    pass({ flow: (v: number) %> { return v } }) @r
    return r
}

@fn bare(a: any): any %> {
    pass { flow: (v: number) %> { return v } } @r
    return r
}

@fn ret(a: any): any %> {
    return { flow: (v: number) %> { return v } }
}
