})
-- nested-flow.lv --
import {pass} from './flow-tools.mjs'

@fn call(a: any): any %> {
    pass({ a: [{ flow: (v: number) %> { return v } }] }) @r
    return r
}

@fn bare(a: any): any %> {
    pass { a: [{ flow: (v: number) %> { return v } }] } @r
    return r
}

@fn ret(a: any): any %> {
    return { a: [{ flow: (v: number) %> { return v } }] }
}
