-- negative-number.lv --
import {add, pass} from './flow-tools.mjs'

@fn call(a: any): any %> {
    pass([-1]) @r
    return r
}

@fn bare(a: any): any %> {
    add -1 2 @r
    return r
}

@fn ret(a: any): any %> {
    return [-1]
}
-- negative-number.lv.js --
import {add,pass} from './flow-tools.mjs'
import {Flow} from 'flow/flow.mjs'
export const call = Flow.fn('call', Flow.create('a', undefined, [Flow.call(pass, [[-1]], 'r'), Flow.ret(Flow.ref('r'))]), {
    get sourceFileName(){ return 'negative-number.lv' },
    get parameterNames(){ return ['a'] }
})
export const bare = Flow.fn('bare', Flow.create('a', undefined, [Flow.call(add, [-1, 2], 'r'), Flow.ret(Flow.ref('r'))]), {
    get sourceFileName(){ return 'negative-number.lv' },
    get parameterNames(){ return ['a'] }
})
export const ret = Flow.fn('ret', Flow.create('a', undefined, [Flow.ret([-1])]), {
    get sourceFileName(){ return 'negative-number.lv' },
    get parameterNames(){ return ['a'] }
})
